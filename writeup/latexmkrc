# Overleaf and local latexmk: compile main.tex with XeLaTeX (fontspec).
$pdf_mode = 5;
@default_files = ('main.tex');
# Reproducible PDF: a fixed timestamp and ID, so two builds of the same source
# give the same bytes (TeX Live honours these two variables).
$ENV{'SOURCE_DATE_EPOCH'} = '1792022400';   # 2026-10-14, the project's draft date
$ENV{'FORCE_SOURCE_DATE'} = '1';
